# Server-only secrets (do not prefix with VITE_)
# Must be configured in deployment/runtime environment, never in frontend bundle.

# ElevenLabs API key used exclusively by src/routes/api/text-to-speech.ts
ELEVENLABS_API_KEY=

# Steuerstoff access code checked by src/routes/api/text-to-speech.ts
TTS_ACCESS_CODE=

# Optional model override. Defaults to eleven_multilingual_v2 when empty.
ELEVENLABS_MODEL_ID=
