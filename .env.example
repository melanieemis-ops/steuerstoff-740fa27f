# Server-only secrets (do not prefix with VITE_)
# Configure these in Cloudflare/runtime secrets, never in the frontend bundle.

# --- KI-Chat: ausschließlich direkte Google-Gemini-API ---
# Cloudflare Secrets-Store-Binding (siehe wrangler.jsonc) oder Worker-Secret.
GEMINIAI_API_KEY=
# Optionales Modell-Override (Standard: gemini-2.5-flash, kostenlose Stufe).
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Optional: URL des eigenen Cloudflare-Workers. Nur setzen, wenn die
# ausführende Runtime selbst kein GEMINIAI_API_KEY-Binding besitzt.
CHAT_WORKER_URL=

# Frontend (öffentlich, enthält nie Keys): eigener Worker als Chat-Endpunkt.
# Leer lassen = same-origin /api/chat.
VITE_CHAT_API_BASE_URL=

# OpenAI API key used by the selectable OpenAI voice (TTS only, nicht Chat).
OPENAI_API_KEY=

# ElevenLabs API key used by the selectable ElevenLabs voice.
ELEVENLABS_API_KEY=

# Steuerstoff access code for ElevenLabs. The route also accepts the legacy
# name TTS_ACCESS_CODE for backwards compatibility.
STEUERSTOFF_TTS=
TTS_ACCESS_CODE=

# Optional ElevenLabs model override. Defaults to eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=
